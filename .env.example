# Required only for live provider/cloud mode; tests use deterministic fakes.
OPSPILOT_APP_ENV=development
OPSPILOT_EXECUTION_MODE=in_process
OPSPILOT_DATABASE_URL=memory://opspilot
OPSPILOT_LLM_API_KEY=
OPSPILOT_LLM_BASE_URL=
OPSPILOT_LLM_MODEL=provider-default
OPSPILOT_EMBEDDING_MODEL=hash-v1

# Optional integrations and safe runtime limits.
OPSPILOT_MCP_SERVER_URL=
OPSPILOT_MLFLOW_TRACKING_URI=
OPSPILOT_LORA_ADAPTER_PATH=
OPSPILOT_REMEDIATION_MODE=simulate
OPSPILOT_AUTO_REMEDIATION=false
OPSPILOT_KUBERNETES_MODE=disabled
OPSPILOT_KUBERNETES_NAMESPACE=ops-demo
OPSPILOT_KUBERNETES_WORKLOAD=checkout-api
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_ACTIVE_ANALYSIS_SLOTS=1
OPSPILOT_QUEUE_CAPACITY=1
OPSPILOT_PROVIDER_TIMEOUT_SECONDS=20
OPSPILOT_PORT=8080
